# PostgreSQL (existing jobai_db with the jobai schema from db/jobai_v1_schema.sql)
DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/jobai_db

# Dedicated test database used by pytest (name must contain "test"; schema is applied automatically)
TEST_DATABASE_URL=postgresql+psycopg://postgres:<password>@localhost:5432/jobai_test_db

# Supabase Auth: public anon/publishable key only. Never put the service-role key here.
SUPABASE_URL=<your-supabase-project-url>
SUPABASE_ANON_KEY=<your-supabase-publishable-key>

# Gemini (Google AI Studio) for the ADK agent
GOOGLE_API_KEY=<your-gemini-api-key>
GOOGLE_GENAI_USE_VERTEXAI=FALSE
JOBAI_MODEL=gemini-2.5-flash

# User Profile MCP server (job_ai_user_profile_mcp)
PROFILE_MCP_URL=http://127.0.0.1:8001/mcp

# FastAPI server
API_HOST=127.0.0.1
API_PORT=8000
